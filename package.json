{
  "name": "svelte-tiler",
  "version": "0.5.0",
  "description": "A small, unstyled library for building tiling user interfaces.",
  "license": "MIT",
  "homepage": "https://github.com/x0k/svelte-tiler#readme",
  "bugs": {
    "url": "https://github.com/x0k/svelte-tiler/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/x0k/svelte-tiler.git"
  },
  "author": "Roman Krasilnikov",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && npm run prepack",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "prepack": "svelte-kit sync && svelte-package && publint",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright test",
    "ci:build": "npm run check && npm run build",
    "ci:version": "changeset version && pnpm install --no-frozen-lockfile"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    },
    "./shared/*": {
      "types": "./dist/shared/*.d.ts",
      "default": "./dist/shared/*.js"
    },
    "./tiles/*.svelte": {
      "types": "./dist/tiles/*.svelte.d.ts",
      "svelte": "./dist/tiles/*.svelte"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^5.40.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@eslint/compat": "^2.0.2",
    "@eslint/js": "^9.39.2",
    "@iconify-json/codicon": "^1.2.44",
    "@iconify-json/material-icon-theme": "^1.2.50",
    "@shikijs/langs": "^3.22.0",
    "@shikijs/themes": "^3.22.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.51.0",
    "@sveltejs/package": "^2.5.7",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@svitejs/changesets-changelog-github-compact": "^1.2.0",
    "@types/node": "^24.10.13",
    "@vitest/browser-playwright": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.15.0",
    "globals": "^17.3.0",
    "marked": "^17.0.2",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "publint": "^0.3.17",
    "shiki": "^3.22.0",
    "svelte": "^5.51.1",
    "svelte-check": "^4.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "unplugin-icons": "^23.0.1",
    "vite": "^7.3.1",
    "vite-plugin-devtools-json": "^1.0.0",
    "vitest": "^4.0.18",
    "vitest-browser-svelte": "^2.0.2"
  },
  "keywords": [
    "svelte",
    "tiling",
    "layout"
  ]
}
